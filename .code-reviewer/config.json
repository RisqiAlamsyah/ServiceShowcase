{
    "model": "gemini-3-flash-preview",
    "base_branch": "development",
    "base_candidates": ["development"],
    "prompt": "reviewer_local.md",
    "max_diff_chars": 800000,
    "exclude_paths": [
        ":(exclude).docs/**",
        ":(exclude)*.md",
        ":(exclude)*.lock",
        ":(exclude)package-lock.json",
        ":(exclude)pnpm-lock.yaml",
        ":(exclude)yarn.lock",
        ":(exclude)node_modules/**",
        ":(exclude).next/**",
        ":(exclude)coverage/**",
        ":(exclude)playwright-report/**",
        ":(exclude)test-results/**",
        ":(exclude)prisma/migrations/**/migration_lock.toml",
        ":(exclude)*.min.js",
        ":(exclude)*.min.css",
        ":(exclude)*.map",
        ":(exclude)*.png",
        ":(exclude)*.jpg",
        ":(exclude)*.jpeg",
        ":(exclude)*.gif",
        ":(exclude)*.webp",
        ":(exclude)*.ico",
        ":(exclude)*.woff",
        ":(exclude)*.woff2",
        ":(exclude)*.ttf",
        ":(exclude)public/**"
    ]
}
